rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['displayName', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.createdAt == request.time
        && (
          request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
          || (request.resource.data.keys().hasOnly(['displayName', 'createdAt', 'username', 'allowRequests'])
            && request.resource.data.username is string
            && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
            && request.resource.data.allowRequests is bool
            && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId)
        );
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'username', 'allowRequests'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.allowRequests is bool
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId;
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_]{3,20}$');
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /groups/{groupId} {
      function member() { return request.auth != null && request.auth.uid in resource.data.memberIds; }
      function validMembers() {
        let members = request.resource.data.memberIds;
        return members.size() >= 1 && members.size() <= 10
          && request.auth.uid in members;
      }
      allow get, list: if member();
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['name', 'memberIds', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'memberIds', 'createdBy', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && validMembers()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && validMembers();
      allow delete: if false;
      match /messages/{messageId} {
        function groupMember() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }
        allow get, list: if groupMember();
        allow create: if groupMember()
          && request.resource.data.keys().hasAll(['senderId', 'senderName', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 40
          && request.resource.data.senderName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /contactRequests/{requestId} {
      allow get: if request.auth != null
        && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.recipientId);
      allow list: if request.auth != null && request.auth.uid == resource.data.senderId;
      allow list: if request.auth != null && request.auth.uid == resource.data.recipientId;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['senderId', 'senderName', 'recipientId', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'recipientId', 'status', 'createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.allowRequests != false
        && !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + request.resource.data.recipientId))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.recipientId + '_' + request.auth.uid));
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          (request.auth.uid == resource.data.recipientId
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'declined'])
          ||
          (request.auth.uid == resource.data.senderId
            && resource.data.status == 'declined'
            && request.resource.data.status == 'pending'
            && !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + resource.data.recipientId))
            && !exists(/databases/$(database)/documents/blocks/$(resource.data.recipientId + '_' + request.auth.uid)))
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.senderId;
    }

    match /connections/{connectionId} {
      allow get, list: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['participantIds', 'requestId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['participantIds', 'requestId', 'createdAt'])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && connectionId == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/contactRequests/$(request.resource.data.requestId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/contactRequests/$(request.resource.data.requestId)).data.recipientId == request.auth.uid
        && getAfter(/databases/$(database)/documents/contactRequests/$(request.resource.data.requestId)).data.senderId in request.resource.data.participantIds
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.participantIds[1] + '_' + request.resource.data.participantIds[0]));
      allow update, delete: if false;
    }

    match /blocks/{blockId} {
      allow get: if request.auth != null
        && request.auth.uid in [resource.data.blockerId, resource.data.blockedUserId];
      allow list: if request.auth != null && request.auth.uid == resource.data.blockerId;
      allow list: if request.auth != null && request.auth.uid == resource.data.blockedUserId;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['blockerId', 'blockedUserId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['blockerId', 'blockedUserId', 'createdAt'])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUserId
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == resource.data.blockerId;
      allow update: if false;
    }

    match /chats/{chatId} {
      function participants() { return resource.data.participantIds; }
      function isParticipant() {
        return request.auth != null && request.auth.uid in participants();
      }
      function noParticipantBlocks() {
        return !exists(/databases/$(database)/documents/blocks/$(resource.data.participantIds[0] + '_' + resource.data.participantIds[1]))
          && !exists(/databases/$(database)/documents/blocks/$(resource.data.participantIds[1] + '_' + resource.data.participantIds[0]));
      }
      // A client must read the deterministic document before creating it in a transaction.
      allow get: if request.auth != null
        && (resource == null || (request.auth.uid in resource.data.participantIds && noParticipantBlocks()));
      allow list: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['participantIds', 'createdAt'])
        && request.resource.data.keys().hasOnly(['participantIds', 'createdAt'])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && exists(/databases/$(database)/documents/connections/$(request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.participantIds[1] + '_' + request.resource.data.participantIds[0]))
        && chatId == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[1]))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /messages/{messageId} {
        function isParticipant() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        }
        function conversationUnblocked() {
          let ids = get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
          return !exists(/databases/$(database)/documents/blocks/$(ids[0] + '_' + ids[1]))
            && !exists(/databases/$(database)/documents/blocks/$(ids[1] + '_' + ids[0]));
        }
        allow read: if isParticipant() && conversationUnblocked();
        allow create: if isParticipant() && conversationUnblocked()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.keys().hasAll(['senderId', 'type', 'text', 'createdAt'])
              && request.resource.data.keys().hasOnly(['senderId', 'type', 'text', 'createdAt'])
              && request.resource.data.type == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.keys().hasAll(['senderId', 'type', 'imageBytes', 'createdAt'])
              && request.resource.data.keys().hasOnly(['senderId', 'type', 'imageBytes', 'text', 'createdAt'])
              && request.resource.data.type == 'image'
              && request.resource.data.imageBytes is bytes
              && request.resource.data.imageBytes.size() > 0
              && request.resource.data.imageBytes.size() <= 200000
              && (!('text' in request.resource.data)
                || (request.resource.data.text is string && request.resource.data.text.size() <= 2000)))
            ||
            (request.resource.data.keys().hasAll(['senderId', 'type', 'documentName', 'documentMimeType', 'documentBytes', 'text', 'createdAt'])
              && request.resource.data.keys().hasOnly(['senderId', 'type', 'documentName', 'documentMimeType', 'documentBytes', 'text', 'createdAt'])
              && request.resource.data.type == 'document'
              && request.resource.data.documentName is string
              && request.resource.data.documentName.size() > 0
              && request.resource.data.documentName.size() <= 120
              && request.resource.data.documentMimeType is string
              && request.resource.data.documentMimeType.size() > 0
              && request.resource.data.documentMimeType.size() <= 100
              && request.resource.data.documentBytes is bytes
              && request.resource.data.documentBytes.size() > 0
              && request.resource.data.documentBytes.size() <= 200000
              && request.resource.data.text is string
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.keys().hasAll(['senderId', 'type', 'latitude', 'longitude', 'createdAt'])
              && request.resource.data.keys().hasOnly(['senderId', 'type', 'latitude', 'longitude', 'createdAt'])
              && request.resource.data.type == 'location'
              && request.resource.data.latitude is number
              && request.resource.data.longitude is number
              && request.resource.data.latitude >= -90
              && request.resource.data.latitude <= 90
              && request.resource.data.longitude >= -180
              && request.resource.data.longitude <= 180)
          );
        allow update, delete: if false;
      }
    }
  }
}
